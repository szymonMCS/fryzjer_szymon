# Baza danych
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5434/salon

# OpenAI (wymagane dla RAG/chatbota)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_LLM_MODEL=gpt-4.1-nano

# Secret key dla cookies (min 32 znaki)
SECRET_KEY=change-this-to-random-secret-key-min-32-characters

# Email (opcjonalnie - Brevo)
BREVO_API_KEY=xkeysib-your-brevo-api-key
BREVO_SENDER_EMAIL=your-email@example.com
BREVO_SENDER_NAME=Salon Fryzjerski

# Admin credentials
ADMIN_USERNAME=szymon
ADMIN_PASSWORD=your_secure_password_here

# Środowisko
DEBUG=true
